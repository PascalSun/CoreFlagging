# The platform this service works for, and the service token both sides hold
# (mint one on the platform: python manage.py create_service_token).
PLATFORM_API_URL=http://platform:8000
PLATFORM_API_TOKEN=

# Host path of the mirror (the folder that holds NVCL/ and _catalog/), mounted read-only at /nvcl.
NVCL_MIRROR=/mnt/qnap/WAGeoData/WAGeoDataPublic/geossdi.dmp.wa.gov.au
# Host path of the AuScope NVCL store mirror (every other State: <State>/<dataset>.zip), mounted read-only at /nvclstore.
NVCL_STORE=/mnt/qnap/WAGeoData/WAGeoDataPublic/nvclstore.data.auscope.org.au

# The app server also serves the platform: keep the model to a few cores there.
CORETRACE_THREADS=4

# ── Frontend (coretrace.nlp-tlp.org, the `frontend` service) ────────────────────────────────
# Inlined into the build: where the platform is, this app's OAuth client there, the Mapbox token.
NEXT_PUBLIC_PLATFORM_URL=https://platform.nlp-tlp.org
NEXT_PUBLIC_PLATFORM_CLIENT_ID=coretrace-web
NEXT_PUBLIC_MAPBOX_TOKEN=
# The assistant's chat route runs on the server side of the frontend: its model, and the platform
# token it logs conversations with (PLATFORM_API_URL / PLATFORM_API_TOKEN above are reused).
OPENROUTER_API_KEY=
# CHAT_PROVIDER=ollama runs the assistant on our own GPU (Ollama, OpenAI-compatible) instead of OpenRouter;
# the OLLAMA_* defaults are the house "Home GPU" endpoint. Empty or openrouter = OpenRouter.
CHAT_PROVIDER=
OLLAMA_BASE_URL=https://ollama.ai4wa.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-8b-32k
