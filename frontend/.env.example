# CoreFlagging frontend. It talks to the platform only through the platform's public API.
NEXT_PUBLIC_PLATFORM_URL=https://platform.nlp-tlp.org     # the platform API and sign-in
NEXT_PUBLIC_PLATFORM_CLIENT_ID=coretrace-web               # this app's OAuth client on the platform (sync_oauth_apps)
NEXT_PUBLIC_PLATFORM_OIDC=1                                # 0 for a dev platform that has no OIDC key
NEXT_PUBLIC_SUPPORT_EMAIL=                                 # where "contact support" points (default: the platform's)
NEXT_PUBLIC_MAPBOX_TOKEN=                                  # Mapbox public token (the map)
NEXT_PUBLIC_API_URL=https://platform.nlp-tlp.org           # same host (legacy name, still read by the shared client)
PLATFORM_API_TOKEN=                                        # server side: the assistant's chat route logs to the platform
OPENROUTER_API_KEY=                                        # server side: the assistant's model (lib/ai/provider.ts)
PLATFORM_API_URL=https://platform.nlp-tlp.org             # server side: where the chat route reaches the platform
CHAT_MODEL=                                                # optional: override the assistant's model id
# CHAT_PROVIDER=ollama runs the assistant on our own GPU (Ollama, OpenAI-compatible) instead of OpenRouter;
# the OLLAMA_* defaults are the house "Home GPU" endpoint. Empty or openrouter = OpenRouter.
CHAT_PROVIDER=
OLLAMA_BASE_URL=https://ollama.ai4wa.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3-8b-32k
